<?xml version="1.0"?>

<!--
  ROS2 Control configuration for bimanual SO-101 robot

  Creates two separate ros2_control systems:
  - left_arm: Controls left arm joints with left_ prefix
  - right_arm: Controls right arm joints with right_ prefix
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Left arm ros2_control system -->
	<ros2_control name="left_arm" type="system">
		<hardware>
			<plugin>gz_ros2_control/GazeboSimSystem</plugin>
		</hardware>

		<joint name="left_shoulder_pan">
			<command_interface name="position">
				<param name="min">-1.91986</param>
				<param name="max">1.91986</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="left_shoulder_lift">
			<command_interface name="position">
				<param name="min">-1.74533</param>
				<param name="max">1.74533</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="left_elbow_flex">
			<command_interface name="position">
				<param name="min">-1.74533</param>
				<param name="max">1.5708</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="left_wrist_flex">
			<command_interface name="position">
				<param name="min">-1.65806</param>
				<param name="max">1.65806</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="left_wrist_roll">
			<command_interface name="position">
				<param name="min">-2.79253</param>
				<param name="max">2.79253</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="left_gripper">
			<command_interface name="position">
				<param name="min">-0.174533</param>
				<param name="max">1.74533</param>
			</command_interface>
			<state_interface name="position" />
		</joint>
	</ros2_control>

	<!-- Right arm ros2_control system -->
	<ros2_control name="right_arm" type="system">
		<hardware>
			<plugin>gz_ros2_control/GazeboSimSystem</plugin>
		</hardware>

		<joint name="right_shoulder_pan">
			<command_interface name="position">
				<param name="min">-1.91986</param>
				<param name="max">1.91986</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="right_shoulder_lift">
			<command_interface name="position">
				<param name="min">-1.74533</param>
				<param name="max">1.74533</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="right_elbow_flex">
			<command_interface name="position">
				<param name="min">-1.74533</param>
				<param name="max">1.5708</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="right_wrist_flex">
			<command_interface name="position">
				<param name="min">-1.65806</param>
				<param name="max">1.65806</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="right_wrist_roll">
			<command_interface name="position">
				<param name="min">-2.79253</param>
				<param name="max">2.79253</param>
			</command_interface>
			<state_interface name="position" />
		</joint>

		<joint name="right_gripper">
			<command_interface name="position">
				<param name="min">-0.174533</param>
				<param name="max">1.74533</param>
			</command_interface>
			<state_interface name="position" />
		</joint>
	</ros2_control>

	<!-- Gazebo ROS2 Control plugin -->
	<gazebo>
		<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
			<parameters>$(find lerobot_controller)/config/bi_so101_controllers.yaml</parameters>
		</plugin>
	</gazebo>

</robot>
