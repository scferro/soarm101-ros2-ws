<?xml version="1.0"?>

<!--
  Bimanual SO-101 Robot with Isaac Sim Integration

  This file creates a bimanual SO-101 robot configured for Isaac Sim.
  It uses topic_based_ros2_control to bridge between Isaac Sim and ROS2.

  Isaac Sim handles the actual physics simulation and publishes joint states.
  This URDF is used by robot_state_publisher and ros2_control on the ROS2 side.
-->

<robot name="bi_so101_isaac" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Configurable Parameters -->
	<!-- Distance of each arm from table center along X-axis (meters) -->
	<xacro:property name="arm_spacing" value="0.25" />

	<!-- Include SO-101 arm macro -->
	<xacro:include filename="$(find lerobot_description)/urdf/so101_macro.xacro" />

	<!-- Include Isaac Sim ROS2 Control -->
	<xacro:include filename="$(find lerobot_description)/urdf/bi_so101_isaac_ros2_control.xacro" />

	<!-- World link (fixed reference frame) -->
	<link name="world" />

	<!-- Left arm - mounted along +X direction from world origin -->
	<xacro:so101_arm prefix="left_" parent="world">
		<origin xyz="${arm_spacing} 0 0" rpy="0 0 0" />
	</xacro:so101_arm>

	<!-- Right arm - mounted along -X direction from world origin -->
	<xacro:so101_arm prefix="right_" parent="world">
		<origin xyz="${-arm_spacing} 0 0" rpy="0 0 0" />
	</xacro:so101_arm>

</robot>
