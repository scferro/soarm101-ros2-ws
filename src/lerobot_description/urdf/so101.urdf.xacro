<?xml version="1.0"?>

<!--
  Single SO-101 Robot Arm

  This file creates a single SO-101 robot arm by instantiating the SO-101 arm macro
  with no prefix. The arm is mounted on a world reference frame.
-->

<robot name="so101" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Include SO-101 arm macro -->
	<xacro:include filename="$(find lerobot_description)/urdf/so101_macro.xacro" />

	<!-- Include ROS2 Control -->
	<xacro:include filename="$(find lerobot_description)/urdf/so101_ros2_control.xacro" />

	<!-- World link (fixed reference frame) -->
	<link name="world" />

	<!-- Single arm - instantiate macro with no prefix -->
	<xacro:so101_arm prefix="" parent="world">
		<origin xyz="0 0 0" rpy="0 0 0" />
	</xacro:so101_arm>

</robot>
